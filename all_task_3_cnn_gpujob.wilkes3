#!/bin/bash
#SBATCH -J cnn_3_job
#SBATCH -A ukaea-ap002-gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --time=12:00:00
#SBATCH --mail-type=NONE
#SBATCH --output=logs/%x-%A_%a.out
#SBATCH --error=logs/%x-%A_%a.err
#SBATCH -p ukaea-amp
#SBATCH --array=1-3  # number of tasks in the array

module purge
module load rhel8/default-amp

application="/home/ir-rous1/conda/envs/fairmast-data-preprocessing/bin/python3.11"
options="/home/ir-rous1/rds/rds-ukaea-ap002-mOlK9qn0PlQ/ir-rous1/output/cnn-baseline/src/cnn_pipeline.py"
config_cnn="/config_cnn.yaml"
workdir="$SLURM_SUBMIT_DIR"

export OMP_NUM_THREADS=1
export PYTHONPATH=$PYTHONPATH:/home/ir-rous1/conda/envs/fairmast-data-preprocessing

cd $workdir
echo "Changed directory to $(pwd)"

# Map SLURM_ARRAY_TASK_ID to your task numbers
task_list=(
    "task_3-1" 
    "task_3-2" 
    "task_3-3")
task_number=${task_list[$SLURM_ARRAY_TASK_ID-1]}  # arrays start at 1
config_list=(
    "/config_cnn_batch_64.yaml"
    "/config_cnn_batch_32.yaml"
    "/config_cnn_batch_32.yaml"
    )
config_cnn=${config_list[$SLURM_ARRAY_TASK_ID-1]}

echo "Running task: $task_number"
srun --unbuffered $application -u $options --task $task_number --config_cnn $config_cnn
